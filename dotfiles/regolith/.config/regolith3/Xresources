
! Overrides for Regolith settings.
!
! To deploy them use `regolith-look refresh`
! If the changes fail to load, ensure that `~/.config/regolith2/Xresources` is
! symlinked to this file.
!
! See reglotih-look-default root resources for an overview of keys
! -> /usr/share/regolith-look/default/root

! Regolith-look configuration
! This field is auto-updated when running `regolith-look set ...`
!
! WARNING: This will also overwrte the symlink.
regolith.look.path: /usr/share/regolith-look/ayu-dark

! Use a Hack font the the bar, this is required for the app icons in the status bar
wm.bar.font: Hack Nerd Font Propo 10

! wm.bar.status_config $HOME/.config/regolith3/i3status-rust/config.toml

! Fix fontsize for Gnome-Terminal
gnome.terminal.font: Hack Nerd Font 10

! The ayu-dark look maps ANSI slots 8 and 15 to the wrong colours: slot 8
! (bright black) gets the light foreground grey and slot 15 (bright white)
! gets a near-black colour. Apps which use ANSI 15 for white text end up
! with unreadable text. Use ayu's comment grey for dim text and its
! foreground for bright white.
gnome.terminal.color8: #565B66
gnome.terminal.color15: #BFBDB6

! Tell regolith to not override the desktop set by gnome
! gnome.wallpaper:

! Clear default keybinds

! wm.binding.settings:
! wm.binding.bluetooth:
! wm.binding.display:
! wm.binding.wifi:

! wm.binding.terminal:
! wm.binding.browser:
! wm.binding.files:
